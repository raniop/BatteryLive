#!/bin/zsh
# postinstall — מפעיל את האפליקציה; היא רושמת את עצמה כפריט כניסה (SMAppService)
CONSOLE_USER=$(stat -f %Su /dev/console)
USER_UID=$(id -u "$CONSOLE_USER" 2>/dev/null)
APP="/Applications/BatteryLive.app"

# הסרת 'הסגר' של macOS
xattr -dr com.apple.quarantine "$APP" 2>/dev/null

if [ -n "$USER_UID" ] && [ "$CONSOLE_USER" != "root" ]; then
  # עצירת מופע ישן (אם רץ) והפעלת החדש בתוך ה-session של המשתמש
  launchctl asuser "$USER_UID" killall BatteryLive 2>/dev/null
  sleep 1
  launchctl asuser "$USER_UID" open "$APP" 2>/dev/null
fi
exit 0
